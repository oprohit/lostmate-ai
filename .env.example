# Local PostgreSQL / Drizzle
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Required for production sessions; use a long random value
SESSION_SECRET=replace-with-a-long-random-secret

# Optional server-side Gemini extraction
GEMINI_API_KEY=
GOOGLE_GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Optional server-side Supabase Storage adapter
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=lostmate-images

# Optional external backend base URL. Leave empty when using same-origin Next routes.
NEXT_PUBLIC_API_BASE_URL=

# Capacitor native shell: use a deployed HTTPS LostMate URL, never localhost in production.
CAPACITOR_SERVER_URL=https://your-lostmate-deployment.example.com
